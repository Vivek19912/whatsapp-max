# ============================================================
# REQUIRED — the app won't start without these.
# ============================================================

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key. Bypasses RLS; used only by server-side
# routes (the webhook, automation engine, and the public API key
# auth path — see docs/public-api.md). Keep this secret — never
# paste it into client code.
#
# Note: the public API (/api/v1) needs no new env var. API keys are
# created in the dashboard (Settings → API keys) and stored hashed
# in the database; this service-role key is what lets the auth path
# look a presented key up without a user session.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp token encryption (64 hex chars = 32 bytes, AES-256-GCM).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value orphans every token encrypted under the previous
# key — users have to re-save their WhatsApp settings to reconnect.
ENCRYPTION_KEY=your-64-char-hex-key-here

# Meta App Secret (Meta for Developers → App Settings → Basic).
# Verifies the HMAC-SHA256 signature on every inbound webhook POST.
# Required — without it the webhook rejects every request.
META_APP_SECRET=your-meta-app-secret

# ============================================================
# RECOMMENDED — safe defaults exist but you'll want to set these.
# ============================================================

# Canonical public URL of this deployment (scheme + host, no trailing
# slash). Used for the sitemap and OG images. Routes that need a
# self-referential URL (invite links from /api/account/invitations,
# any future email-bound link) derive the origin from the request
# itself, so this variable is *only* needed when the request-derived
# origin would be wrong — e.g. when generating links from a cron job
# or a background worker that has no incoming request.
#
# REQUIRED IN PRODUCTION for password-recovery emails: the forgot-
# password flow redirects through /auth/callback (see
# src/lib/auth/recovery.ts getAppBaseUrl), which always uses this
# variable in production builds and never the browser origin — so a
# reset requested from any origin still mails a production link.
# Production builds fail the reset request loudly instead of
# mailing a localhost link when this is missing or invalid. Set it
# to the exact canonical https URL (no localhost, no trailing slash):
#   NEXT_PUBLIC_SITE_URL=https://whatsappmax.in
# Local development ignores it for recovery links and uses the live
# dev-server origin instead (plain http://localhost:3000).
NEXT_PUBLIC_SITE_URL=https://crm.example.com

# Auth session cookie domain (optional). Leave UNSET on localhost/CI.
#
# When set (production), this makes the Supabase auth cookies shared
# between the apex host and its `www` subdomain so a signed-in user is
# never "logged out" just by reaching the other hostname. Use the
# leading-dot form of your registrable domain, e.g. `.whatsappmax.in`.
#
#   NEXT_PUBLIC_SUPABASE_COOKIE_DOMAIN=.whatsappmax.in
#
# Session persistence is already >=30 days out of the box: @supabase/ssr
# writes auth cookies with a 400-day max-age and Supabase's refresh token
# keeps the access token refreshed on demand.

# ============================================================
# OPTIONAL — only needed if you use the feature.
# ============================================================

# Defense-in-depth allow-list for the hostnames that
# /api/account/invitations is willing to publish in invite URLs.
# Comma-separated, no scheme, no port (just hostnames).
#
# Why this exists: when NEXT_PUBLIC_SITE_URL is unset, invite URLs
# are derived from the incoming request's `Host` / `X-Forwarded-
# Host` header. On a typical proxied deploy the proxy sets these
# to your canonical hostname and they're trustworthy. On a *bare*
# deployment exposed to the public internet, an attacker could
# POST to the API directly with a spoofed `Host: phishing.example`
# and receive an invite URL pointing at their site.
#
# When this var is set, hostnames not on the list are rejected
# (the request falls through to the wacrm.tech fallback with a
# console.warn). When unset, behavior is unchanged from earlier
# versions — the request-derived host is trusted.
#
# Most operators don't need this: setting NEXT_PUBLIC_SITE_URL to
# your canonical URL already pins invite links there. This is for
# operators who want belt-and-braces or run multi-tenant setups
# where one app instance serves several hostnames.
#
# Example:
#   ALLOWED_INVITE_HOSTS=crm.example.com,crm-staging.example.com

# Shared secret protecting GET /api/automations/cron. Required if you
# use Wait steps in automations (a scheduled pinger drains pending
# executions). Generate any long random string:
#   openssl rand -hex 32
#
# On a self-hosted (EC2/VPS) box you don't have to wire this by hand —
# run the helper once and it sets the secret, restarts the app, installs
# a per-minute drain cron, and verifies the endpoint:
#   bash scripts/setup-automation-cron.sh
# See docs/automations-and-cron.md for the manual steps + other schedulers.
# AUTOMATION_CRON_SECRET=generate-a-long-random-string

# Meta App ID (Meta for Developers → App Settings → Basic). Required to
# create/edit message templates with an IMAGE header: Meta only accepts a
# Resumable-Upload media handle (not a plain URL) as the header sample, and
# that upload is app-scoped. Without it, image-header template submission
# returns a clear error; text/body-only templates are unaffected. Pair
# with META_APP_SECRET.
# META_APP_ID=your-meta-app-id

# When "true", POST /api/whatsapp/templates/submit skips the Meta call
# and stores the row with a synthetic `dry-run-<uuid>` meta_template_id.
# Set this in CI and local development so you can exercise the full
# template UI without a real WABA. Leave unset (or "false") in prod.
# WHATSAPP_TEMPLATES_DRY_RUN=true

# ------------------------------------------------------------------
# AI reply assistant (optional)
# ------------------------------------------------------------------
# The AI assistant is bring-your-own-key: each account pastes its own
# OpenAI or Anthropic key under Settings → AI Assistant. The key is
# stored AES-256-GCM-encrypted with ENCRYPTION_KEY (above) — there is
# NO global provider key env var, and nothing here is required for the
# feature to work. The two vars below only tune behaviour.
#
# The AI knowledge base (migration 030) uses Postgres full-text search
# out of the box. Optional semantic search needs the `pgvector`
# extension — migration 030 runs `CREATE EXTENSION IF NOT EXISTS vector`
# (Supabase has it available) — plus a per-account embeddings key set in
# Settings → AI Assistant. Still no env var required.

# Per-call timeout for provider requests, in milliseconds. Default 30000.
# AI_REQUEST_TIMEOUT_MS=30000

# How many recent text messages of a conversation to send the model as
# context (draft + auto-reply). Default 20.
# AI_CONTEXT_MESSAGE_LIMIT=20

# ------------------------------------------------------------------
# Email notifications (optional)
# ------------------------------------------------------------------
# Powers the "Notify by email" flow node (internal email notification
# when a contact reaches a step). Emails are queued to the database by
# the flow runner and sent in the background by the flows cron — a
# missing/slow/failing provider can never block or fail a WhatsApp
# flow. When no provider is configured the node still works; jobs are
# queued and marked failed (with a logged reason) instead of sending.
#
# Two providers are supported; Resend is preferred (works on serverless):
#
#   # Resend (https://resend.com) — create an API key under API Keys.
#   RESEND_API_KEY=re_xxxxxxxxxxxx
#   # Verified sender on the Resend account. When unset, Resend's sandbox
#   # sender "WACRM <onboarding@resend.dev>" is used, which Resend only
#   # delivers to the account-owner's email. Set a verified address like
#   # "WACRM <notifications@yourdomain.com>" for real recipients.
#   RESEND_FROM=WACRM <notifications@yourdomain.com>
#
#   # OR classic SMTP:
#   SMTP_HOST=smtp.example.com
#   SMTP_PORT=587
#   SMTP_USER=
#   SMTP_PASSWORD=
#   SMTP_FROM=
#
#   # SMTP_PASS is accepted as an alias for SMTP_PASSWORD (Gmail App
#   # Password setups commonly use SMTP_PASS). MAIL_FROM_EMAIL and
#   # MAIL_FROM_NAME optionally brand the envelope sender (displayed as
#   # "NAME <EMAIL>"); otherwise SMTP_FROM, then SMTP_USER, is used.
#
# ------------------------------------------------------------------
# Meta Lead Ads — new-lead email notifications (optional, Gmail SMTP)
# ------------------------------------------------------------------
# When enabled per account (Settings › Integrations › Meta › Lead
# capture › New-lead email notifications), one email is sent to the
# salesperson assigned to each new Meta lead, from the shared mailbox
# below. Transport is Gmail SMTP ONLY — Resend is never used as a
# fallback. Create a Gmail App Password (Google Account › Security ›
# 2-Step Verification › App passwords) and set it as SMTP_PASS on the
# deployed server. Never commit real credentials here.
#
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=leadnotificationss@gmail.com
#   SMTP_PASS=
#   MAIL_FROM_NAME=WhatsApp Max
#   MAIL_FROM_EMAIL=leadnotificationss@gmail.com
#
# EMAIL_TIMEOUT_MS:   per-step timeout for provider calls, in ms. Default 10000.

# ------------------------------------------------------------------
# Web Push notifications (optional)
# ------------------------------------------------------------------
# Powers mobile/desktop push notifications on new inbox messages. When
# these are absent the feature no-ops cleanly — the app still runs, it
# just never sends a push and the Settings → Notifications toggle stays
# unavailable.
#
# Generate a keypair once with:  npx web-push generate-vapid-keys
# The PUBLIC key is exposed to the browser (NEXT_PUBLIC_) by design; the
# PRIVATE key is server-only and must never be shipped to the client.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contact URI push services can use to reach you (mailto: or https).
# Defaults to mailto:admin@example.com if unset.
# VAPID_SUBJECT=mailto:you@yourdomain.com
#
# Per-subscription HTTP round-trip budget for web push, in ms. Default
# 10000. Bounds a slow/hung push service so one device's delayed
# response can't pin the server for the OS-level socket timeout (~2
# minutes) and hold up other devices' fan-out.
# PUSH_REQUEST_TIMEOUT_MS=10000

# ------------------------------------------------------------------
# Travel CRM lead integration (server-only — never NEXT_PUBLIC_).
# The WACRM server calls Travel CRM server-to-server with the
# Bearer credential below. Without these, the Workspace
# "Create in Travel CRM" action reports "not configured".
# ------------------------------------------------------------------
# TRAVEL_CRM_BASE_URL=https://app.travelagencycrm.in
# TRAVEL_CRM_INTEGRATION_SECRET=wacrm_paste_minted_secret_here

# ------------------------------------------------------------------
# Google OAuth (required for Flow Tables Sheets + Meta Lead Ads Sheets sync)
# ------------------------------------------------------------------
# Both Sheets features share the one Google Cloud OAuth client below.
# Tokens are stored AES-256-GCM-encrypted per account and never leave
# the server. Create the client at Google Cloud Console → APIs &
# Services → Credentials → OAuth client ID (Web application), enable
# the Google Sheets API + Google Drive API, and whitelist EVERY
# redirect URI your deployment uses:
#
#   Flow Tables Sheets:  {origin}/api/integrations/google/callback
#   Meta Lead Ads Sheets: {origin}/api/integrations/meta-lead-ads/google/callback
#
# (origin = your NEXT_PUBLIC_SITE_URL, or the request host in dev.)
# Meta Sheets requests the sensitive `spreadsheets` scope (read/write
# the customer's own sheets, incl. existing ones) + `userinfo.email`;
# until Google verifies the app it is subject to the 100-user cap and
# an "unverified app" consent screen. Flow Tables keeps the
# non-sensitive `drive.file` scope and is unaffected.
# GOOGLE_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ------------------------------------------------------------------
# Meta Lead Ads integration (server-only — never NEXT_PUBLIC_).
# Leads captured by Facebook/Instagram Instant Forms flow into the
# existing Workspace as one virtual table per enabled form. The
# integration is DISABLED unless ALL FOUR values below are set, and
# the Graph API version is never hardcoded — pin a current, supported
# version (see docs/meta-lead-ads.md). Use a SEPARATE Meta app from
# the WhatsApp one if you prefer, but META_LEAD_ADS_APP_SECRET is the
# App Secret for THIS app and is used to verify inbound webhooks.
# ------------------------------------------------------------------
# META_LEAD_ADS_APP_ID=your-meta-app-id
# META_LEAD_ADS_APP_SECRET=your-meta-app-secret
# META_LEAD_ADS_WEBHOOK_VERIFY_TOKEN=any-long-random-string
# META_GRAPH_VERSION=v21.0

